# Local development settings. Copy to `.env` and edit.
# On Square Cloud, set these in the dashboard instead of uploading `.env`.

# Local MongoDB:
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=agent_playground

# Atlas / Square Cloud managed MongoDB over TLS:
# MONGODB_URI=mongodb://user:password@host:port/?tls=true
# MONGODB_TLS_CA_FILE=certificate.pem
# MONGODB_TLS_CERT_FILE=certificate.pem

# Dashboard (read-only observation) password. CHANGE THIS before deploying.
DASHBOARD_PASSWORD=playground
DASHBOARD_SESSION_HOURS=12

# Agent token lifetime.
TOKEN_TTL_HOURS=24

# Set to false only for local HTTP development. Keep true behind HTTPS.
COOKIE_SECURE=false

# Seed three example tasks for every new connection.
SEED_TASKS=true

# Activity log and SSE tuning.
ACTIVITY_LIMIT=200
SSE_HEARTBEAT_SECONDS=15

# Local server (main.py reads these).
HOST=0.0.0.0
PORT=8000
